DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="replace-with-openssl-rand-hex-32"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
AUTH_DEV_LOGIN_EMAIL="optional-member-email-for-local-only"
# Demo deployment only — NEVER set on the production project.
# Enables one-click "Socio"/"Admin" logins and disables outbound email.
DEMO_MODE="false"

# Email (Resend). Without these the app still works; outbound email is skipped
# and the supplier-email button toasts a missing-config error.
RESEND_API_KEY="re_..."
MAIL_FROM="WeGrocery <noreply@example.org>"
# Outside the Vercel production deployment (VERCEL_ENV != "production", which
# includes local dev) every email is rewritten to this address: cc dropped,
# subject prefixed with "[STAGING -> <original recipient>]". If unset, sends
# are refused there. Set it on local, staging and Preview; NEVER on Production.
EMAIL_REDIRECT_TO="you@example.org"
# Absolute base URL used for links inside notification emails (no trailing
# slash). Falls back to VERCEL_PROJECT_PRODUCTION_URL when unset; if neither is
# present the links are omitted.
APP_BASE_URL="https://gas.example.org"

# Membership-card check (WallyFor). Optional: set BOTH to require an active
# card for Google sign-in and to let verified card holders self-onboard (they
# are created as 'utenti'). Leave unset on deployments without WallyFor: login
# then stays limited to the members table. Server-only, never NEXT_PUBLIC_.
WALLYFOR_API_KEY=""
WALLYFOR_MERCHANT_ID=""

# Online top-ups (Stripe Checkout). Optional: without a key the /ricarica page
# only shows the bank-transfer details. Live keys (sk_live_/rk_live_) work only
# on a real production deploy, test keys everywhere else (lib/payments/config.ts).
# The webhook endpoint is <app>/api/stripe/webhook with the events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired and
# charge.refunded; its signing secret goes in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
