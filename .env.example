# WeGrocery environment. Copy to .env.local for local development; on Vercel
# set these in the project's Environment Variables. The app shows what is set
# (names only) in admin -> Impostazioni -> Configuration status, and
# `npm run doctor` prints the same.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres (Neon). Apply the migrations before the first deploy:
#   DATABASE_URL=... node scripts/db-migrate.mjs
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the sessions: `openssl rand -hex 32`.
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Sign-in is by email link, so email (Resend, below) is needed. Google is an
# optional extra: an OAuth client of type "Web application", redirect URI
# <app>/api/auth/callback/google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# The first admin of a new installation: this address signs in (email link
# or Google) and becomes admin. Used only while the group has no active
# admin; remove it once you are in.
BOOTSTRAP_ADMIN_EMAIL=""

# ── Identity of the group ───────────────────────────────────────────────────

# Name, logo, colours, language, currency, time zone, bank details: see
# "White-label" in the README. Without it the app is plain WeGrocery.
NEXT_PUBLIC_BRAND_JSON=""

# Absolute base URL for links inside emails (no trailing slash). Falls back to
# VERCEL_PROJECT_PRODUCTION_URL; with neither, email links are left out.
APP_BASE_URL="https://gas.example.org"

# ── Optional integrations: everything works without them ────────────────────

# Email (Resend). Needed for the sign-in link; without it only Google (if set)
# lets members in, and notifications stay in the app.
RESEND_API_KEY=""
MAIL_FROM="WeGrocery <noreply@example.org>"
# Outside the Vercel production deployment (VERCEL_ENV != "production", local
# dev included) every email goes to this address instead, subject prefixed
# "[STAGING -> <original recipient>]". If unset, sends are refused there.
# Set it on local, staging and Preview; NEVER on Production.
EMAIL_REDIRECT_TO=""

# Online payments (Stripe Checkout). Live keys (sk_live_/rk_live_) work only on
# a real production deploy, test keys everywhere else. The webhook endpoint is
# <app>/api/stripe/webhook with the events in REQUIRED_STRIPE_EVENTS
# (lib/payments/config.ts); its signing secret goes in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Membership-card check (WallyFor). Set BOTH to require an active card at
# sign-in and let card holders self-onboard; leave both unset otherwise.
WALLYFOR_API_KEY=""
WALLYFOR_MERCHANT_ID=""

# Error reporting: server errors go to Sentry, without member data.
SENTRY_DSN=""

# Anonymous counts for a fleet console (WeGrocery Console, console/): with a
# secret of at least 32 characters (`openssl rand -hex 32`), requests signed
# with it get /api/instance-stats; without it the route answers 404.
INSTANCE_STATS_SECRET=""

# Apply pending migrations at every production build (docs/upgrading.md).
# Set it on the Production environment only.
MIGRATE_ON_BUILD=""

# ── Special deployments ─────────────────────────────────────────────────────

# Demo deployment only, NEVER on a real group's project: one-click "Socio" /
# "Admin" logins, no outbound email.
DEMO_MODE="false"
# Local development only: sign in as this member without Google.
AUTH_DEV_LOGIN_EMAIL=""
