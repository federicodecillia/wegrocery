{
  "name": "wegrocery-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "node scripts/migrate-on-build.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.1.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10"
