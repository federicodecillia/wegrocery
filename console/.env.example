# WeGrocery Console: copy to .env.local for local development.
# Never commit real values. On Vercel, mark the secrets "Sensitive".

# --- Registry database (the console's own Neon project) ---
DATABASE_URL=
# true: `npm run build` applies the pending console migrations first (production builds only)
MIGRATE_ON_BUILD=true

# --- Operator sign-in ---
# At least 16 characters, else the login is disabled
CONSOLE_PASSWORD=
# At least 32 characters: openssl rand -hex 32
CONSOLE_SESSION_SECRET=
# 32 bytes, hex (64 characters) or base64: openssl rand -hex 32
# Encrypts the stored INSTANCE_STATS_SECRET of each instance. Changing it
# makes the stored secrets unreadable (paste them again on each instance page).
CONSOLE_ENCRYPTION_KEY=

# --- Daily cron (Vercel sends Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Console emails (alerts, new requests, handover); skipped when unset ---
RESEND_API_KEY=
MAIL_FROM=
CONSOLE_ALERT_EMAIL=

# --- Provisioning (the operator's personal tokens) ---
VERCEL_TOKEN=
NEON_API_KEY=
# RESEND_API_KEY above also creates the groups' domains and sending keys.
# Shared sending domain, already verified on the operator's Resend account:
CONSOLE_SHARED_MAIL_DOMAIN=
CONSOLE_SHARED_MAIL_DOMAIN_ID=

# --- Source repository (defaults shown) ---
# WEGROCERY_REPO=federicodecillia/wegrocery
# Numeric GitHub id of the repository; read from the public GitHub API when unset
# WEGROCERY_REPO_ID=
# Optional, only raises the GitHub API rate limit
# GITHUB_TOKEN=
